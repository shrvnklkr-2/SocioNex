# Copy to .env.local (dev) or set in Vercel/hosting env (production build).
# Backend base URL with no trailing slash — e.g. https://socionex-api.onrender.com
VITE_API_URL=http://127.0.0.1:8001

# Backend (Render): set these so filings survive restarts and CORS allows your frontend.
# DATABASE_URL=postgresql://...
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
